CREATE TABLE IotInput(
  eventEnqueuedUtcTime datetime,
  sensorId nvarchar(max),
  value float
);
 
CREATE TABLE AutoReportProgressReferenceInput(
  sensorId nvarchar(max),
  jobId nvarchar(max),
  jobDataAreaId nvarchar(max),
  isJobCompleted nvarchar(max),
  jobRegistrationStartDateTime datetime,
  jobRegistrationStopDateTime datetime,
  jobLastRegistrationDateTime datetime,
  unitPerCycle float,
  pulsePerCycle float  
);
 
WITH CurrentlyRunningJobs AS
(
  SELECT
  I.sensorId,
  I.eventEnqueuedUtcTime,
  I.value,
  R.jobDataAreaId,
  R.jobId,
  R.unitPerCycle,
  R.pulsePerCycle,
  R.jobRegistrationStartDateTime
  FROM IotInput I
  TIMESTAMP BY I.eventEnqueuedUtcTime
  JOIN AutoReportProgressReferenceInput R
  ON R.sensorId = I.sensorId
  WHERE I.eventEnqueuedUtcTime >= R.jobRegistrationStartDateTime
  AND R.isJobCompleted = 'No'
  AND DATEDIFF(year, R.jobRegistrationStopDateTime, CAST('1900-01-01' as datetime)) = 0
),
PulseCounter AS
(
  SELECT
  *,
  COUNT(*) OVER (
    PARTITION BY sensorId, jobId, jobDataAreaId
    LIMIT DURATION(day, 7)
  ) AS totalPulses
  FROM CurrentlyRunningJobs
),
CycleCompletion AS
(
  SELECT
  *,
  CASE
    WHEN totalPulses % pulsePerCycle = 0 THEN 1
    ELSE 0
  END AS cycleCompleted,
  totalPulses / pulsePerCycle AS completedCycles
  FROM PulseCounter
)
 
SELECT
  jobDataAreaId AS dataAreaId,
  sensorId AS machineId,
  jobId AS jobId,
  unitPerCycle AS unitsProduced,
  totalPulses AS totalPulses,
  completedCycles AS completedCycles,
  eventEnqueuedUtcTime AS timestamp,
  'ProductionAutoReportProgress' AS notificationType
INTO NotificationOutput
FROM CycleCompletion
WHERE cycleCompleted = 1
